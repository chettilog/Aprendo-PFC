# Modelo do arquivo .env do backend. Copie para .env e preencha.
# O .env real nunca vai para o GitHub (está no .gitignore).

# Banco de dados: use DATABASE_URL (Neon, em produção) OU as variáveis DB_* (PostgreSQL local)
# DATABASE_URL=postgresql://usuario:senha@servidor/neondb?sslmode=require
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=sua_senha
DB_NAME=aprendo_db

# Chave para assinar os tokens de login: longa e aleatória (pelo menos 32 caracteres).
# Para gerar uma: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Correção das explicações pela IA (opcional; sem ela, a correção usa as palavras-chave)
GEMINI_API_KEY=

# Envio do código de recuperação de senha pelo Brevo (opcional no desenvolvimento)
BREVO_API_KEY=
EMAIL_REMETENTE=
# No desenvolvimento, mostra o e-mail no terminal em vez de enviar
EMAIL_SIMULADO=true

# Só em produção: endereço do app que pode chamar a API pelo navegador
# ORIGENS_PERMITIDAS=https://aprendo-app.netlify.app
